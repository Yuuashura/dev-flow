# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every variable without a default in application.yaml is REQUIRED: the service
# refuses to start without it, which is deliberate. A missing secret should be a
# startup failure, not a silent fallback to a value that is public in git.

# DATABASE
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/yuu_saas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# REDIS
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# RABBITMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# JWT — must be identical across auth/workspace/project/billing/integration.
# Generate: openssl rand -hex 32
JWT_SECRET=

# MAILING — Gmail requires an App Password, not the account password
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# OAUTH — from Google Cloud Console / GitHub Developer Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/oauth2/callback
GITHUB_WEBHOOK_SECRET=

# INTERNAL SERVICE-TO-SERVICE
NOTIFICATION_INTERNAL_TOKEN=
AUTH_SERVICE_URL=http://localhost:8081

# FRONTEND / APP
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:5173

# RATE LIMIT LOGIN
LOGIN_RATE_LIMIT_EMAIL_IP=10
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# PAYMENT GATEWAY (XENDIT)
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=

# PUBLIC URLS
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=/
TRUSTED_PROXY_HOPS=1
NGROK_URL=
NGROK_AUTHTOKEN=
