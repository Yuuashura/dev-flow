# ==========================================
# DATABASE (Container postgres-app di VPS port 5433)
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5433/yuuashura_db
SPRING_DATASOURCE_USERNAME=yuuashura
SPRING_DATASOURCE_PASSWORD=

# ==========================================
# REDIS & RABBITMQ
# ==========================================
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ==========================================
# JWT SECRET
# ==========================================
JWT_SECRET=

# ==========================================
# OAUTH CREDENTIALS (Domain Production)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dev-flow.yuuashura.my.id/oauth2/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://dev-flow.yuuashura.my.id/oauth2/callback
GITHUB_WEBHOOK_SECRET=

# ==========================================
# INTERNAL SERVICE COMMUNICATION
# ==========================================
NOTIFICATION_INTERNAL_TOKEN=
AUTH_SERVICE_URL=http://auth-service:8081

# ==========================================
# MAILING (Gmail SMTP)
# ==========================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ==========================================
# FRONTEND / APP URLS (Production Domain)
# ==========================================
FRONTEND_URL=https://dev-flow.yuuashura.my.id
APP_URL=https://dev-flow.yuuashura.my.id

# ==========================================
# RATE LIMIT LOGIN
# ==========================================
LOGIN_RATE_LIMIT_EMAIL_IP=10
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ==========================================
# PAYMENT GATEWAY CREDENTIALS (XENDIT)
# ==========================================
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_CALLBACK_URL=https://dev-flow.yuuashura.my.id/api/xendit/webhook

# ==========================================
# PRODUCTION PUBLIC URLS & PROXY
# ==========================================
CORS_ALLOWED_ORIGINS=https://dev-flow.yuuashura.my.id,http://localhost:3000,http://localhost:5173
VITE_API_URL=/
TRUSTED_PROXY_HOPS=2
