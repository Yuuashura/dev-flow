  "components": {
    "schemas": {
      "CallbackRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 512,
            "minLength": 0
          },
          "state": {
            "type": "string",
            "maxLength": 512,
            "minLength": 0
          }
        },
        "required": [
          "code"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "jobTitle": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "profileComplete": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "DELETED"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "globalRole": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN"
            ]
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "GOOGLE",
                "GITHUB"
              ]
            }
          }
        }
      },
      "CreateNotificationRequest": {
        "type": "object",
        "properties": {
          "recipientEmail": {
            "type": "string"
          },
          "recipientUserId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "content": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          },
          "priority": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "actionUrl": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "actionUrl": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResendVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "email"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "confirmPassword",
          "email",
          "fullName",
          "password"
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
