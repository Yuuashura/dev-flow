{
  "openapi": "3.1.0",
  "info": {
    "title": "DevFlow — Integration Service",
    "description": "Integrasi GitHub dan webhook ber-HMAC.\n\nAmbil token lewat POST /api/v1/auth/login, lalu tempel di\ntombol Authorize untuk mencoba endpoint yang terlindungi.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "api-gateway"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/integrations/github/webhook": {
      "post": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "handleWebhook",
        "parameters": [
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations/github/projects/{projectId}/repo": {
      "get": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "getLinkedRepo",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "linkRepo",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkRepoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "unlinkRepo",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/integrations/github/workspaces/{workspaceId}": {
      "get": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "getInstallations",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GithubInstallation"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations/github/repos": {
      "get": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "listRepos",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GithubRepoItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations/github/projects/{projectId}/commits": {
      "get": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "listCommits",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GithubCommitItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations/github/projects/{projectId}/activities": {
      "get": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "getActivities",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NormalizedGithubActivity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations/github/me": {
      "get": {
        "tags": [
          "integration-controller"
        ],
        "operationId": "getConnectedAccount",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LinkRepoRequest": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "maxLength": 39,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "repo": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "branch": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      },
      "GithubInstallation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "installationId": {
            "type": "string"
          },
          "accountLogin": {
            "type": "string"
          },
          "accountType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "installedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GithubRepoItem": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "defaultBranch": {
            "type": "string"
          },
          "htmlUrl": {
            "type": "string"
          },
          "privateRepo": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "GithubCommitItem": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "authorAvatar": {
            "type": "string"
          },
          "committedAt": {
            "type": "string",
            "format": "date-time"
          },
          "htmlUrl": {
            "type": "string"
          },
          "additions": {
            "type": "integer",
            "format": "int32"
          },
          "deletions": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "NormalizedGithubActivity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "activityType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Access token dari /api/v1/auth/login",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}