{
  "openapi": "3.1.0",
  "info": {
    "title": "DevFlow — Billing Service",
    "description": "Paket langganan dan pembayaran Xendit.\n\nAmbil token lewat POST /api/v1/auth/login, lalu tempel di\ntombol Authorize untuk mencoba endpoint yang terlindungi.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "api-gateway"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/xendit/webhook": {
      "post": {
        "tags": [
          "xendit-webhook-controller"
        ],
        "operationId": "xenditWebhook",
        "parameters": [
          {
            "name": "x-callback-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/XenditInvoiceCallback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/billing/webhook": {
      "post": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "xenditWebhook_1",
        "parameters": [
          {
            "name": "x-callback-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/XenditInvoiceCallback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/billing/owner/upgrade": {
      "post": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "upgrade",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerPlan"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/billing/owner/checkout": {
      "post": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "checkout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/workspaces/{workspaceId}/subscription": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getSubscription",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/plans": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getPlans",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plan"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/plans/{code}": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getPlanByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/payments": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getOrderHistory",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageOrderHistoryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/payments/{externalId}": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getPaymentStatus",
        "parameters": [
          {
            "name": "externalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/owner/plan": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getMyPlan",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerPlan"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/owner/plan/limits": {
      "get": {
        "tags": [
          "billing-controller"
        ],
        "operationId": "getMyPlanLimits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlanLimits"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "XenditInvoiceCallback": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "external_id": {
            "type": "string"
          },
          "paid_amount": {
            "type": "integer",
            "format": "int64"
          },
          "payment_method": {
            "type": "string"
          },
          "payment_channel": {
            "type": "string"
          },
          "paid_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OwnerPlan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "planCode": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "planStart": {
            "type": "string",
            "format": "date-time"
          },
          "planEnd": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "properties": {
          "workspaceSlug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]{2,100}$"
          },
          "customerName": {
            "type": "string",
            "maxLength": 150,
            "minLength": 0
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "minLength": 0
          },
          "customerPhone": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          "companyName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "customerEmail",
          "customerName",
          "workspaceSlug"
        ]
      },
      "CheckoutResponse": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "invoiceUrl": {
            "type": "string"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "currentPeriodStart": {
            "type": "string",
            "format": "date-time"
          },
          "currentPeriodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceAmount": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "billingInterval": {
            "type": "string"
          },
          "trialDays": {
            "type": "integer",
            "format": "int32"
          },
          "maxWorkspaces": {
            "type": "integer",
            "format": "int32"
          },
          "maxProjectsPerWorkspace": {
            "type": "integer",
            "format": "int32"
          },
          "maxMembersPerWorkspace": {
            "type": "integer",
            "format": "int32"
          },
          "maxStorageGb": {
            "type": "integer",
            "format": "int32"
          },
          "githubRepos": {
            "type": "integer",
            "format": "int32"
          },
          "milestonesPerProject": {
            "type": "integer",
            "format": "int32"
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderHistoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "externalId": {
            "type": "string"
          },
          "planName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "paymentChannel": {
            "type": "string"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "invoiceUrl": {
            "type": "string"
          }
        }
      },
      "PageOrderHistoryResponse": {
        "type": "object",
        "properties": {
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderHistoryResponse"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "PageableObject": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "paged": {
            "type": "boolean"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "unpaged": {
            "type": "boolean"
          }
        }
      },
      "SortObject": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean"
          },
          "sorted": {
            "type": "boolean"
          },
          "unsorted": {
            "type": "boolean"
          }
        }
      },
      "PaymentStatusResponse": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "invoiceUrl": {
            "type": "string"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlanLimits": {
        "type": "object",
        "properties": {
          "planCode": {
            "type": "string"
          },
          "maxWorkspaces": {
            "type": "integer",
            "format": "int32"
          },
          "maxProjectsPerWorkspace": {
            "type": "integer",
            "format": "int32"
          },
          "maxMembersPerWorkspace": {
            "type": "integer",
            "format": "int32"
          },
          "maxStorageGb": {
            "type": "integer",
            "format": "int32"
          },
          "githubRepos": {
            "type": "integer",
            "format": "int32"
          },
          "milestonesPerProject": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Access token dari /api/v1/auth/login",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}